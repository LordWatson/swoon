# Normalise line endings so the repo is identical on Windows, macOS and Linux.
* text=auto eol=lf

# Shell scripts MUST keep LF. A CRLF shebang line makes bash fail with
# "bad interpreter: /usr/bin/env bash^M" — which would silently break the
# pre-commit hook and the module-docs hook on Linux, macOS and in CI.
*.sh            text eol=lf
.githooks/*     text eol=lf

# Windows-native scripts keep CRLF.
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# Binary — never touch these.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.webp          binary
*.woff          binary
*.woff2         binary
*.ttf           binary
*.otf           binary
*.pdf           binary
*.mp3           binary
*.mp4           binary
*.m4a           binary

# Keep generated and lock files out of diffs and language stats.
package-lock.json       linguist-generated=true -diff
composer.lock           linguist-generated=true -diff
graphify-out/graph.json linguist-generated=true -diff

# Don't ship development-only files in a `git archive` export.
/.github            export-ignore
/.githooks          export-ignore
/.claude            export-ignore
/docs               export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
