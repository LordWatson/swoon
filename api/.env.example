###############################################################################
# Swoon API — environment template
#
# Copy to .env and fill in. NEVER commit a real secret to this file.
# Keys you must add by hand are marked REQUIRED-BY-HAND.
###############################################################################

###############################################################################
# Product
#
# The working name lives here and in config/swoon.php only. Renaming the product
# means changing SWOON_NAME.
#
# APP_NAME below is NOT interpolated from it on purpose: Dotenv only substitutes
# a variable defined earlier in the same file, and quietly leaves the literal
# text '${SWOON_NAME}' when it is not — which would end up in the header of a
# real email. AppServiceProvider::boot() points app.name and mail.from.name at
# config('swoon.name') instead, so APP_NAME's own value only feeds the cache
# prefix, the Redis prefix and the session cookie name.
###############################################################################

SWOON_NAME=Swoon
SWOON_TAGLINE="Your relationship concierge"
SWOON_SUPPORT_EMAIL=hello@swoon.test
SWOON_URL_MARKETING=https://swoon.test
SWOON_URL_PRIVACY=https://swoon.test/privacy
SWOON_URL_TERMS=https://swoon.test/terms

# Must match the Expo app's scheme in mobile/app.config.ts
SWOON_DEEP_LINK_SCHEME=swoon
SWOON_DEEP_LINK_HOST=link.swoon.test

APP_NAME=Swoon
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://swoon-api.test
APP_VERSION=dev

APP_LOCALE=en_GB
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB
APP_TIMEZONE=Europe/London

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

###############################################################################
# Logging
###############################################################################

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

###############################################################################
# Database — MySQL 8 (Herd ships MySQL on 3306)
#
# Create the databases once:
#   mysql -u root -e "CREATE DATABASE swoon; CREATE DATABASE swoon_test;"
###############################################################################

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=swoon
DB_USERNAME=root
DB_PASSWORD=

###############################################################################
# Sessions, cache, queue
#
# The database queue driver is deliberate for local dev: it needs no extra
# service, and `composer dev` runs the worker. All AI calls run in queued jobs.
###############################################################################

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

###############################################################################
# Sanctum
#
# The mobile app authenticates with personal access tokens, not cookies, so no
# stateful domains are needed. Tokens are long-lived; revocation is explicit.
###############################################################################

SANCTUM_TOKEN_EXPIRY_MINUTES=null

###############################################################################
# Anthropic — REQUIRED-BY-HAND
#
# Server-side ONLY. This key must never ship in the mobile app.
# Set AI_DRIVER=fake to run without any network or cost (the test default).
###############################################################################

ANTHROPIC_API_KEY=
AI_DRIVER=anthropic
AI_MODEL_STRONG=claude-opus-5-5
AI_MODEL_LIGHT=claude-haiku-5-5
AI_COST_GUARD_COUPLE_PENCE=500
AI_COST_GUARD_GLOBAL_PENCE=50000

###############################################################################
# Mail — Resend  (REQUIRED-BY-HAND: RESEND_API_KEY)
#
# Use MAIL_MAILER=log locally until the sending domain is verified in Resend.
###############################################################################

MAIL_MAILER=log
# MAIL_MAILER=resend
RESEND_API_KEY=

# POST /resend/webhook is off in AppServiceProvider, not here — the package
# only signature-checks it when RESEND_WEBHOOK_SECRET is set, so a deploy that
# omitted this line would reopen it. Set RESEND_ROUTES=true together with a
# secret when bounce handling is built.

MAIL_FROM_ADDRESS="hello@swoon.test"
MAIL_FROM_NAME="${SWOON_NAME}"

###############################################################################
# RevenueCat — subscriptions and digital IAP  (REQUIRED-BY-HAND)
#
# Entitlements are decided server-side from these webhooks. The app never
# decides access on its own. See docs/PRICING.md section 6.
###############################################################################

REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_PROJECT_ID=

###############################################################################
# Stripe — PHYSICAL goods and real-world services ONLY  (REQUIRED-BY-HAND)
#
# Never use Stripe for a digital feature or subscription: that is an App Store
# rejection. See docs/PRICING.md section 5.
###############################################################################

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

###############################################################################
# S3-compatible storage — photos and voice notes
#
# PRIVATE bucket. Media is served only through short-lived signed URLs.
# Local dev uses FILESYSTEM_DISK=local and needs none of this.
###############################################################################

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-2
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
MEDIA_SIGNED_URL_TTL_MINUTES=15

###############################################################################
# Error tracking — Sentry
#
# Leave SENTRY_LARAVEL_DSN empty locally; the SDK then does nothing.
# send_default_pii stays OFF: this app holds intimate personal data.
###############################################################################

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_SEND_DEFAULT_PII=false

###############################################################################
# Sign in with Apple / Google — REQUIRED-BY-HAND (Phase 1)
###############################################################################

APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_SECRET=
